{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 6am on Monday"],
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
  },
  "packageRules": [
    {
      "description": "Combine all GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Combine all Python backend dependency updates into a single PR",
      "matchDatasources": ["pypi"],
      "groupName": "Python backend dependencies"
    },
    {
      "description": "Group uv version updates in Dockerfile into a single PR",
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "groupName": "uv"
    },
    {
      "description": "Combine all frontend dependency updates into a single PR",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json", "frontend/package-lock.json"],
      "groupName": "Frontend dependencies"
    }
  ]
}
